# JDS Branded Ordering — environment template
# Copy to .env / host secret stores. NEVER commit real secrets.
# Legend: REQUIRED | OPTIONAL | CLOVER-SPECIFIC | PROVIDER-NEUTRAL
# Verified against backend/app/*/config.py, app/main.py, platform/config.py (2026-09-10).

# =============================================================================
# Core runtime (PROVIDER-NEUTRAL)
# =============================================================================
DATABASE_URL=                          # REQUIRED — PostgreSQL SQLAlchemy URL (prefer postgresql+psycopg://...)
FRONTEND_URL=https://order.jdsstudio.ca  # REQUIRED prod — public storefront / owner UI origin
PUBLIC_APP_URL=https://api.example.com   # REQUIRED prod — public API origin (OAuth/webhook callbacks)
JDS_ENVIRONMENT=production             # REQUIRED — development | staging | production
JDS_AUTH_PROVIDER=supabase             # REQUIRED — supabase (local auth only in development)
JDS_AUTH_SECURE_COOKIES=true           # REQUIRED prod — true in HTTPS environments
JDS_APPLICATION_KEY=jds-commerce       # REQUIRED — application key for auth bootstrap
JDS_ORGANIZATION_SLUG=the-guest-house  # OPTIONAL legacy default tenant slug (compat)
JDS_ORGANIZATION_NAME=The Guest House  # OPTIONAL bootstrap display name
JDS_APPLICATION_NAME=JDS Commerce      # OPTIONAL bootstrap application name
JDS_PAYMENT_MODE=production            # OPTIONAL — production | review (staging review uses review)
JDS_OUTBOUND_INTEGRATIONS_ENABLED=true # OPTIONAL — false disables outbound provider calls (staging)

# =============================================================================
# Supabase Auth (PROVIDER-NEUTRAL identity — not a payment provider)
# =============================================================================
SUPABASE_AUTH_URL=https://YOUR_PROJECT.supabase.co          # REQUIRED prod
SUPABASE_AUTH_PUBLISHABLE_KEY=                              # REQUIRED prod — browser-safe publishable key
SUPABASE_AUTH_SECRET_KEY=                                   # REQUIRED prod — SERVER ONLY
JDS_AUTH_SESSION_PEPPER=                                    # REQUIRED — >=32 random chars; SERVER ONLY
JDS_CUSTOMER_PERSISTENT_SESSION_DAYS=30                     # OPTIONAL

# =============================================================================
# Media storage (PROVIDER-NEUTRAL)
# =============================================================================
JDS_MEDIA_STORAGE=supabase             # REQUIRED prod — supabase | local (local refused in production)
JDS_SUPABASE_STORAGE_URL=https://YOUR_PROJECT.supabase.co   # REQUIRED when JDS_MEDIA_STORAGE=supabase
JDS_SUPABASE_STORAGE_SERVICE_ROLE_KEY= # REQUIRED when supabase — SERVER ONLY
JDS_SUPABASE_STORAGE_BUCKET=jds-media  # REQUIRED when supabase — private bucket
JDS_LOCAL_MEDIA_ROOT=                  # OPTIONAL/dev — local filesystem root (not /tmp in prod)
JDS_STARTER_MEDIA_ROOT=                # OPTIONAL — starter product media pack root

# =============================================================================
# Storefront hostname / tenancy (PROVIDER-NEUTRAL)
# =============================================================================
JDS_STOREFRONT_BASE_DOMAIN=order.jdsstudio.ca  # REQUIRED for merchant self-serve hosted subdomains
JDS_STOREFRONT_SCHEME=https                    # OPTIONAL — http|https (default https)
JDS_LEGACY_LADELS_HOSTS=                       # OPTIONAL — comma hosts allowed for Ladel's compat default
JDS_DEFAULT_BILLING_PLAN_KEY=                  # OPTIONAL — default plan key when provisioning
JDS_BILLING_ENFORCEMENT_ENABLED=false          # OPTIONAL — entitlement enforcement switch (not MoR billing)
JDS_STANDARD_PLAN_MONTHLY_CAD=150              # OPTIONAL — public list price for jds-standard (CAD dollars)
# JDS_STANDARD_PLAN_MONTHLY_CENTS=15000        # OPTIONAL — cents override wins over CAD dollars

# =============================================================================
# Controlled demo pilot (M2.5) — NOT production, NOT Guest House / Ladel's
# =============================================================================
JDS_DEMO_INVITE_CODE=                          # OPTIONAL — when set, /build signup requires matching invite_code
# Optional CAPTCHA (do NOT enable until Marc creates vendor account + keys):
# JDS_DEMO_CAPTCHA_PROVIDER=turnstile          # turnstile | hcaptcha | recaptcha
# JDS_DEMO_CAPTCHA_SITE_KEY=
# JDS_DEMO_CAPTCHA_SECRET_KEY=                 # SERVER ONLY

# =============================================================================
# Clover payment adapter (CLOVER-SPECIFIC — first working adapter; not required for non-Clover thesis)
# =============================================================================
CLOVER_APP_ID=                         # REQUIRED only when enabling Clover for a deployment
CLOVER_APP_SECRET=                     # REQUIRED with Clover — SERVER ONLY
CLOVER_TOKEN_ENCRYPTION_KEY=           # REQUIRED with Clover — Fernet key; SERVER ONLY
CLOVER_STATE_SECRET=                   # REQUIRED with Clover — OAuth state (>=32, != webhook secret)
CLOVER_WEBHOOK_SECRET=                 # REQUIRED with Clover — webhook HMAC (>=32)
CLOVER_ENVIRONMENT=sandbox             # REQUIRED with Clover — sandbox | production
CLOVER_PAGE_CONFIG_UUID=               # OPTIONAL — hosted checkout page config
CLOVER_MERCHANT_ID=                    # OPTIONAL/legacy sandbox single-merchant credential
CLOVER_ECOMMERCE_PRIVATE_TOKEN=        # OPTIONAL/legacy — must be unset in multi-tenant OAuth mode

# =============================================================================
# Web Push (PROVIDER-NEUTRAL)
# =============================================================================
WEB_PUSH_VAPID_PUBLIC_KEY=             # REQUIRED when push enabled
WEB_PUSH_VAPID_PRIVATE_KEY=            # REQUIRED when push enabled — SERVER ONLY
WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com
WEB_PUSH_SUBSCRIPTION_ENCRYPTION_KEY=  # REQUIRED when push enabled — SERVER ONLY
PUSH_ENROLLMENT_ENABLED=false
PUSH_RELEASE_ENABLED=false
PUSH_BATCH_SIZE=50
PUSH_REQUEST_TIMEOUT_SECONDS=10
PUSH_DEFAULT_TTL_SECONDS=14400
PUSH_GENERAL_TTL_SECONDS=14400
PUSH_MAX_ATTEMPTS=4
PUSH_RETENTION_DAYS=90

# =============================================================================
# Local development / review only (PROVIDER-NEUTRAL) — never set in production
# =============================================================================
JDS_ENABLE_LOCAL_REVIEW=false
JDS_LOCAL_REVIEW_ORIGIN=http://127.0.0.1:5173
JDS_LOCAL_REVIEW_PROXY_ORIGIN=
JDS_LOCAL_AUTH_EMAIL=owner@local.jds.test
JDS_LOCAL_AUTH_PASSWORD=
JDS_LOCAL_REVIEW_RESET_NEW_MERCHANT=false

# =============================================================================
# Staging review only (PROVIDER-NEUTRAL) — see docs/STAGING_REVIEW_DEPLOYMENT.md
# =============================================================================
JDS_ENABLE_STAGING_REVIEW=false
JDS_STAGING_INSTANCE_ID=
JDS_STAGING_ALLOWED_HOSTS=
JDS_STAGING_AUTH_PASSWORD=
JDS_STAGING_SEED_CONFIRMATION=
JDS_STAGING_REVIEW_RESET_NEW_MERCHANT=false

# =============================================================================
# Frontend build (PROVIDER-NEUTRAL) — browser-safe only
# =============================================================================
# VITE_API_BASE_URL=                   # OPTIONAL — empty for same-origin / Netlify proxy; never put secrets in VITE_*
# Netlify staging also uses JDS_STAGING_API_ORIGIN (build-time proxy target) — see docs/STAGING_REVIEW_DEPLOYMENT.md

# =============================================================================
# Tests
# =============================================================================
# TEST_DATABASE_URL=postgresql+psycopg://guesthouse:password@127.0.0.1:5432/guesthouse_test
